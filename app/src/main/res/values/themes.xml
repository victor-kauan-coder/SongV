<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SongV" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/songv_grafite</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash nativa: grafite + marca. Fica visível até o tema salvo carregar (ver MainActivity). -->
    <style name="Theme.SongV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/songv_grafite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.SongV</item>
    </style>
</resources>
